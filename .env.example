# EVDS API Configuration
# Get your API key from: https://evds2.tcmb.gov.tr/ (Profile → API Anahtarı)

# Your EVDS API key (required)
EVDS_API_KEY=your-api-key-here

# Comma-separated list of series codes to fetch (required)
# Examples:
# - TP.DK.USD.A: USD Exchange Rate (Buy)
# - TP.DK.EUR.A: EUR Exchange Rate (Buy)
# - TP.FG.J0: Consumer Price Index
EVDS_SERIES_CODES=TP.DK.USD.A,TP.DK.EUR.A,TP.DK.GBP.A

# Start date for data fetching in YYYY-MM-DD format (required)
EVDS_START_DATE=2020-01-01

# Output directory for JSON files (optional, default: ./data)
EVDS_OUTPUT_DIR=./data
